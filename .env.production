# ===========================================
# PUERTO DE LA API
# ===========================================
PORT=3001

# ===========================================
# BASE DE DATOS (USAR MYSQL EXISTENTE)
# ===========================================
# IMPORTANTE: Usar el host "mysql" que es el nombre del servicio en tu docker-compose
# Debes crear una base de datos separada para este proyecto
DATABASE_URL=

# ===========================================
# VTEX SCRAPING (REQUERIDO)
# ===========================================
# Hash SHA256 para queries GraphQL de VTEX
# Extraer con: node scripts/extractVtexHash.js
# Ver COMO_OBTENER_HASH.md para instrucciones
VTEX_SHA256_HASH=3eca26a431d4646a8bbce2644b78d3ca734bf8b4ba46afe4269621b64b0fb67d

# ===========================================
# REDIS CACHE (REQUERIDO)
# ===========================================
# Upstash Redis - https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# AUTENTICACIÓN API (REQUERIDO)
# ===========================================
# Token para endpoints de scrapers
# Generar con: openssl rand -hex 32
API_TOKEN=

# ===========================================
# CONFIGURACIÓN DE SCRAPERS (OPCIONAL)
# ===========================================
# Array JSON de códigos EAN para modo "eans"
# Ejemplo: ["7790742028433","7790387003130"]
PRODUCT_EANS=

# Retención de jobs en memoria (horas)
JOB_RETENTION_HOURS=24

# ===========================================
# WEBHOOKS Y NOTIFICACIONES (OPCIONAL)
# ===========================================
# Slack webhook para notificaciones
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Webhook genérico para eventos de scrapers
WEBHOOK_URL=
